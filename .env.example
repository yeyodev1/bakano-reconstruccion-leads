# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.
# Estas variables las lee api/lead.ts del lado servidor; no llegan al navegador.

# Webhook entrante del workflow de GoHighLevel que recibe los leads.
GHL_WEBHOOK_URL=

# Pixel de Meta. El ID es público (va en index.html); el token NO.
META_PIXEL_ID=
META_CAPI_TOKEN=

# Opcional: código de Test Events del Events Manager, para depurar sin datos reales.
META_CAPI_TEST_CODE=
